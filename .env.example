# Canonical site URL. Required in production: without it robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_URL=https://whitesec.energy

# Google Analytics 4 measurement ID. Optional; analytics loads only after cookie consent.
NEXT_PUBLIC_GA_ID=

# Enquiry email delivery through Resend (https://resend.com). Without a key, enquiries are only written to the server log.
RESEND_API_KEY=
# CONTACT_FROM must use a domain verified in Resend, for example "Whitesec Energy <energy@whitesec.id>".
CONTACT_FROM=
# Where enquiries go. By default each enquiry goes to the entity of the country the visitor chose
# (support@whitesec.id for Indonesia, support@whitesec.au for Australia). Override one or both:
CONTACT_TO_ID=
CONTACT_TO_AU=
# Or send every enquiry to one address:
CONTACT_TO=
